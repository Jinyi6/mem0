   "source": [
    "import json\n",
    "\n",
    "ori = \"membench824.json\"\n",
    "with open(ori, 'r', encoding='utf-8') as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "subset = data[:100]\n",
    "\n",
    "out_path = ori.replace('.json', '_100.json')\n",
    "with open(out_path, 'w', encoding='utf-8') as f:\n",
    "    json.dump(subset, f, ensure_ascii=False, indent=2)"
   ]
  }
